# apps/admin — public configuration.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CDN_BASE_URL=http://localhost:9000/healthy-aahar-media-local
NEXT_PUBLIC_SENTRY_DSN=

# Firebase ADMIN project web config — a DIFFERENT project from the customer
# app. This separation is the security boundary described in ADR-010.
NEXT_PUBLIC_FIREBASE_ADMIN_API_KEY=
NEXT_PUBLIC_FIREBASE_ADMIN_AUTH_DOMAIN=healthy-aahar-admin-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_ADMIN_PROJECT_ID=healthy-aahar-admin-local
NEXT_PUBLIC_FIREBASE_ADMIN_APP_ID=
NEXT_PUBLIC_USE_AUTH_EMULATOR=true

SENTRY_AUTH_TOKEN=
