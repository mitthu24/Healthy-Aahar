{
  "name": "@healthy-aahar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ../../scripts/with-env.mjs tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/with-env.mjs vitest run",
    "test:watch": "vitest",
    "bootstrap:first-admin": "tsx src/scripts/bootstrap-first-admin.ts",
    "recover:admin-password-setup": "tsx src/scripts/recover-admin-password-setup.ts",
    "clean": "rm -rf .turbo dist coverage"
  },
  "dependencies": {
    "@healthy-aahar/auth": "workspace:*",
    "@healthy-aahar/config": "workspace:*",
    "@healthy-aahar/contracts": "workspace:*",
    "@healthy-aahar/core": "workspace:*",
    "@healthy-aahar/db": "workspace:*",
    "@healthy-aahar/notifications": "workspace:*",
    "@healthy-aahar/observability": "workspace:*",
    "@healthy-aahar/storage": "workspace:^",
    "@hono/node-server": "^1.13.3",
    "hono": "^4.6.8",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
