{
  "name": "@healthy-aahar/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@healthy-aahar/config": "workspace:*",
    "@healthy-aahar/core": "workspace:*",
    "@healthy-aahar/db": "workspace:*",
    "@healthy-aahar/observability": "workspace:*",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
