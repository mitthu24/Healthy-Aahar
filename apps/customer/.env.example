# apps/customer — public configuration.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CDN_BASE_URL=http://localhost:9000/healthy-aahar-media-local
NEXT_PUBLIC_SENTRY_DSN=

# Firebase CUSTOMER project web config.
# Public by design: it identifies a project, it does not authorise anything.
# Security comes from Firebase rules, App Check and our API (docs/07 §2).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=healthy-aahar-customer-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=healthy-aahar-customer-local
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_USE_AUTH_EMULATOR=true

SENTRY_AUTH_TOKEN=
