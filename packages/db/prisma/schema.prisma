// Healthy Aahar — database schema
//
// Implements docs/04-DATABASE-DESIGN.md in full (PHASE 02).
//
// Conventions (docs/04 §1), applied without exception:
//   - snake_case tables (plural) via @@map, snake_case columns via @map
//   - UUIDv7 primary keys, generated in the application (ADR-012)
//   - TIMESTAMPTZ in UTC; business-day logic uses Asia/Kolkata (ADR-007)
//   - money is BIGINT paise, every column suffixed _paise (ADR-006)
//   - business_id on aggregate roots (ADR-005); children are scoped via parent
//   - CHECK constraints, partial indexes and generated columns live in the
//     migration SQL — Prisma cannot express them. Each is noted at its model.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, citext, btree_gin]
}

// ══════════════════════════════════════════════════════════════════════════
// Enums — docs/04 §1.5
// ══════════════════════════════════════════════════════════════════════════

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

/// Serviceability state for cities and pincodes.
/// An enum, not a boolean: the admin UI must distinguish "switched off" from
/// "not launched yet", and the two produce different customer messages.
enum ServiceabilityStatus {
  ACTIVE
  INACTIVE
  COMING_SOON

  @@map("serviceability_status")
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("job_run_status")
}

enum UserType {
  CUSTOMER
  ADMIN

  @@map("user_type")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("product_status")
}

/// Editorial availability, distinct from quantitative stock (BR-C4).
enum AvailabilityState {
  AVAILABLE
  OUT_OF_STOCK
  DISCONTINUED

  @@map("availability_state")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  RETURNED

  @@map("order_status")
}

enum OrderSource {
  ONE_TIME
  SUBSCRIPTION

  @@map("order_source")
}

enum OrderChannel {
  WEB
  MOBILE
  ADMIN
  SYSTEM

  @@map("order_channel")
}

enum CancelActor {
  CUSTOMER
  ADMIN
  SYSTEM

  @@map("cancel_actor")
}

enum PaymentMethod {
  COD
  ONLINE
  WALLET
  CREDIT

  @@map("payment_method")
}

enum PaymentStatus {
  DUE
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED

  @@map("payment_status")
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("refund_status")
}

enum SubscriptionStatus {
  DRAFT
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  SUSPENDED

  @@map("subscription_status")
}

enum SubDeliveryStatus {
  SCHEDULED
  SKIPPED
  ORDER_CREATED
  FULFILLED
  FAILED
  CANCELLED

  @@map("sub_delivery_status")
}

enum FrequencyType {
  DAILY
  WEEKLY
  CUSTOM_DAYS
  ALTERNATE_DAYS
  MONTHLY

  @@map("frequency_type")
}

enum InventoryReason {
  PURCHASE
  PRODUCTION
  ORDER_RESERVED
  ORDER_RELEASED
  ORDER_CONSUMED
  MANUAL_ADJUSTMENT
  WASTAGE
  DAMAGE
  RETURN
  EXPIRY
  STOCK_TAKE

  @@map("inventory_reason")
}

enum NotificationChannelType {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
  SMS

  @@map("notification_channel")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD

  @@map("outbox_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@map("discount_type")
}

enum ImageStatus {
  PENDING
  READY
  FAILED

  @@map("image_status")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("idempotency_status")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

// ══════════════════════════════════════════════════════════════════════════
// Governance — docs/04 §3
// ══════════════════════════════════════════════════════════════════════════

/// The operating entity. Exactly one row at MVP.
/// The column that makes multi-business expansion a data change rather than
/// a migration (ADR-005).
model Business {
  id           String        @id @db.Uuid
  name         String
  slug         String        @db.Citext
  timezone     String        @default("Asia/Kolkata")
  currency     String        @default("INR")
  supportEmail String?       @map("support_email") @db.Citext
  supportPhone String?       @map("support_phone")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  cities            City[]
  servicePincodes   ServicePincode[]
  settings          Setting[]
  categories        Category[]
  products          Product[]
  combos            Combo[]
  tags              Tag[]
  deliveryZones     DeliveryZone[]
  deliverySlots     DeliverySlot[]
  businessHolidays  BusinessHoliday[]
  carts             Cart[]
  orders            Order[]
  subscriptionPlans SubscriptionPlan[]
  subscriptions     Subscription[]
  inventory         Inventory[]
  coupons           Coupon[]
  roles             Role[]
  adminUsers        AdminUser[]
  customerProfiles  CustomerProfile[]
  outbox            NotificationOutbox[]

  @@unique([slug])
  @@map("businesses")
}

/// Runtime configuration an admin can change without a deploy.
/// The boundary against environment variables (docs/27 §6): anything the
/// business might reasonably change without an engineer belongs here.
model Setting {
  id          String   @id @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  key         String   @db.Citext
  value       Json
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, key])
  @@index([businessId, isPublic])
  @@map("settings")
}

/// Durable, queryable business audit. Distinct from technical logs (doc 28).
/// Append-only by database GRANT — the application role has no UPDATE/DELETE.
model AuditLog {
  id           String   @id @db.Uuid
  businessId   String?  @map("business_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorType    String   @map("actor_type")
  actorEmail   String?  @map("actor_email") @db.Citext
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  before       Json?
  after        Json?
  metadata     Json?
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Execution record for every scheduled worker job. Powers the admin
/// job-health screen and the dead-man's-switch alerts (docs/28 §8).
model JobRun {
  id             String       @id @db.Uuid
  jobName        String       @map("job_name")
  startedAt      DateTime     @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?    @map("finished_at") @db.Timestamptz(6)
  status         JobRunStatus @default(RUNNING)
  itemsProcessed Int          @default(0) @map("items_processed")
  error          String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([jobName, startedAt(sort: Desc)])
  @@map("job_runs")
}

// ══════════════════════════════════════════════════════════════════════════
// Identity — docs/04 §4
// ══════════════════════════════════════════════════════════════════════════

/// The bridge between a Firebase identity and our application.
/// Holds NO credentials — no password hash, no OTP, no refresh token.
/// If this database leaks, nobody can authenticate with it (doc 07 §1).
model User {
  id            String        @id @db.Uuid
  firebaseUid   String        @map("firebase_uid")
  userType      UserType      @map("user_type")
  email         String?       @db.Citext
  phone         String?
  emailVerified Boolean       @default(false) @map("email_verified")
  phoneVerified Boolean       @default(false) @map("phone_verified")
  status        AccountStatus @default(ACTIVE)
  lastLoginAt   DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerProfile CustomerProfile?
  adminUser       AdminUser?              @relation("AdminUserAccount")
  invitedAdmins   AdminUser[]             @relation("AdminUserInvitedBy")
  auditLogs       AuditLog[]
  notifications   Notification[]
  notifPrefs      NotificationPreference[]
  idempotencyKeys IdempotencyKey[]

  // The same person can be both a customer and an admin: two rows, two
  // Firebase identities, two projects (ADR-010).
  @@unique([firebaseUid, userType])
  @@index([userType, status])
  @@map("users")
}

/// Customer business data. Separated from `users` so identity and commercial
/// concerns evolve independently, and so a future admin-created offline
/// customer needs no Firebase identity.
model CustomerProfile {
  id                 String    @id @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  displayName        String?   @map("display_name")
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             String?
  defaultAddressId   String?   @map("default_address_id") @db.Uuid
  preferredSlotId    String?   @map("preferred_slot_id") @db.Uuid
  marketingOptIn     Boolean   @default(false) @map("marketing_opt_in")
  totalOrders        Int       @default(0) @map("total_orders")
  lifetimeValuePaise BigInt    @default(0) @map("lifetime_value_paise")
  firstOrderAt       DateTime? @map("first_order_at") @db.Timestamptz(6)
  lastOrderAt        DateTime? @map("last_order_at") @db.Timestamptz(6)
  /// Internal CS notes — never shown to the customer.
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  preferredSlot DeliverySlot?  @relation(fields: [preferredSlotId], references: [id], onDelete: SetNull)
  addresses     Address[]      @relation("CustomerAddresses")
  carts         Cart[]
  orders        Order[]
  subscriptions Subscription[]
  favorites     Favorite[]
  reviews       Review[]
  redemptions   CouponRedemption[]

  @@index([businessId])
  @@map("customer_profiles")
}

/// Staff business data, separate from customer profiles.
/// Invariant (BR-SEC6): at least one active super admin must exist —
/// enforced in the service layer, not the schema.
model AdminUser {
  id                   String    @id @db.Uuid
  businessId           String    @map("business_id") @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  fullName             String    @map("full_name")
  employeeCode         String?   @map("employee_code")
  designation          String?
  isSuperAdmin         Boolean   @default(false) @map("is_super_admin")
  mfaEnabled           Boolean   @default(false) @map("mfa_enabled")
  lastPasswordChangeAt DateTime? @map("last_password_change_at") @db.Timestamptz(6)
  invitedBy            String?   @map("invited_by") @db.Uuid
  invitationAcceptedAt DateTime? @map("invitation_accepted_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User            @relation("AdminUserAccount", fields: [userId], references: [id], onDelete: Restrict)
  inviter  User?           @relation("AdminUserInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  roles    AdminUserRole[]

  @@index([businessId])
  @@map("admin_users")
}

/// Roles are DATA so operations can create new combinations without a deploy.
/// Permissions are CODE because they are a contract with the routes (ADR-019).
model Role {
  id          String   @id @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  key         String   @db.Citext
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  admins      AdminUserRole[]

  @@unique([businessId, key])
  @@map("roles")
}

/// Static catalogue seeded by migration, not admin-editable.
model Permission {
  id          String   @id @db.Uuid
  key         String   @unique @db.Citext
  resource    String
  action      String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUserRole {
  adminUserId String   @map("admin_user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedBy   String?  @map("granted_by") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

/// The customer address book, and the serviceability anchor.
///
/// `city` (text) is what the customer typed; `cityId` is the resolved match.
/// Both are kept because an UNSERVICEABLE address must still be saveable
/// (BR-D1) — a NOT NULL cityId would make that impossible (ADR-029).
model Address {
  id                   String    @id @db.Uuid
  customerProfileId    String    @map("customer_profile_id") @db.Uuid
  label                String?
  recipientName        String    @map("recipient_name")
  recipientPhone       String    @map("recipient_phone")
  line1                String
  line2                String?
  landmark             String?
  city                 String
  cityId               String?   @map("city_id") @db.Uuid
  state                String
  pincode              String
  country              String    @default("IN")
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  deliveryZoneId       String?   @map("delivery_zone_id") @db.Uuid
  deliveryInstructions String?   @map("delivery_instructions")
  isDefault            Boolean   @default(false) @map("is_default")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerProfile CustomerProfile @relation("CustomerAddresses", fields: [customerProfileId], references: [id], onDelete: Restrict)
  resolvedCity    City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  deliveryZone    DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  carts           Cart[]
  orders          Order[]
  subscriptions   Subscription[]
  subDeliveries   SubscriptionDelivery[]

  @@index([customerProfileId])
  @@index([pincode])
  @@index([deliveryZoneId])
  @@map("addresses")
}

// ══════════════════════════════════════════════════════════════════════════
// Catalogue — docs/04 §5
// ══════════════════════════════════════════════════════════════════════════

/// Two-level hierarchy (category → subcategory). Deeper nesting is allowed by
/// the schema but not by the service layer (BR-C1).
model Category {
  id             String    @id @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String
  slug           String    @db.Citext
  description    String?
  imageUrl       String?   @map("image_url")
  iconUrl        String?   @map("icon_url")
  displayOrder   Int       @default(0) @map("display_order")
  isActive       Boolean   @default(true) @map("is_active")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  business Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, displayOrder])
  @@index([businessId, isActive])
  @@map("categories")
}

/// The marketing and informational entity. **Not purchasable and has no
/// price** — only a variant is (docs/04 §5.2). This removes the classic
/// "does the product or the variant carry the price?" ambiguity.
model Product {
  id               String    @id @db.Uuid
  businessId       String    @map("business_id") @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  name             String
  slug             String    @db.Citext
  shortDescription String?   @map("short_description")
  description      String?
  status           ProductStatus @default(DRAFT)
  isSubscribable   Boolean   @default(false) @map("is_subscribable")
  isFeatured       Boolean   @default(false) @map("is_featured")
  isBestseller     Boolean   @default(false) @map("is_bestseller")
  isNew            Boolean   @default(false) @map("is_new")
  popularityScore  Int       @default(0) @map("popularity_score")
  ingredients      String?
  nutrition        Json?
  allergens        String[]
  preparationNote  String?   @map("preparation_note")
  storageNote      String?   @map("storage_note")
  shelfLifeHours   Int?      @map("shelf_life_hours")
  dietaryTags      String[]  @map("dietary_tags")
  seoTitle         String?   @map("seo_title")
  seoDescription   String?   @map("seo_description")
  /// Generated STORED column — see migration SQL. Prisma cannot express it.
  searchVector     Unsupported("tsvector")? @map("search_vector")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category  Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants  ProductVariant[]
  images    ProductImage[]
  tags      ProductTag[]
  favorites Favorite[]
  reviews   Review[]

  @@unique([id, businessId], name: "product_id_business_id")
  @@index([categoryId, status])
  @@index([businessId, status])
  @@index([popularityScore(sort: Desc)])
  @@map("products")
}

/// The ONLY purchasable unit. Every cart line, order line, combo item,
/// subscription item and inventory row points here (docs/04 §5.3).
model ProductVariant {
  id                     String            @id @db.Uuid
  businessId             String            @map("business_id") @db.Uuid
  productId              String            @map("product_id") @db.Uuid
  sku                    String            @db.Citext
  name                   String
  unit                   String
  unitValue              Decimal           @map("unit_value") @db.Decimal(10, 3)
  mrpPaise               BigInt?           @map("mrp_paise")
  pricePaise             BigInt            @map("price_paise")
  subscriptionPricePaise BigInt?           @map("subscription_price_paise")
  /// Internal only — never serialised by a public or customer endpoint (BR-C7).
  costPaise              BigInt?           @map("cost_paise")
  taxRateBps             Int               @default(0) @map("tax_rate_bps")
  availability           AvailabilityState @default(AVAILABLE)
  isDefault              Boolean           @default(false) @map("is_default")
  displayOrder           Int               @default(0) @map("display_order")
  maxOrderQuantity       Int?              @map("max_order_quantity")
  deletedAt              DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Composite FK: a variant and its product must belong to the SAME business.
  // A plain product_id FK would let a future multi-business bug attach a
  // variant across a tenant boundary (ADR-005).
  product           Product                 @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  images            ProductImage[]
  comboItems        ComboItem[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  subscriptionItems SubscriptionItem[]
  planItems         SubscriptionPlanItem[]
  inventory         Inventory[]
  zoneAvailability  ProductZoneAvailability[]

  @@index([productId, displayOrder])
  @@index([availability])
  @@index([businessId])
  @@map("product_variants")
}

model ProductImage {
  id           String      @id @db.Uuid
  productId    String      @map("product_id") @db.Uuid
  variantId    String?     @map("variant_id") @db.Uuid
  storageKey   String      @map("storage_key")
  url          String
  altText      String?     @map("alt_text")
  width        Int?
  height       Int?
  blurDataUrl  String?     @map("blur_data_url")
  status       ImageStatus @default(PENDING)
  displayOrder Int         @default(0) @map("display_order")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_images")
}

/// Free-form merchandising tags, distinct from `products.dietary_tags`
/// which is a controlled vocabulary used for filtering.
model Tag {
  id         String   @id @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  key        String   @db.Citext
  name       String
  type       String   @default("MERCH")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products ProductTag[]

  @@unique([businessId, key])
  @@map("tags")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

/// A bundle of >= 2 variants sold as one priced line.
/// Has no inventory of its own — stock is its components' stock (BR-B9).
model Combo {
  id                     String        @id @db.Uuid
  businessId             String        @map("business_id") @db.Uuid
  name                   String
  slug                   String        @db.Citext
  shortDescription       String?       @map("short_description")
  description            String?
  imageUrl               String?       @map("image_url")
  pricingMode            String        @default("FIXED") @map("pricing_mode")
  pricePaise             BigInt?       @map("price_paise")
  discountType           DiscountType? @map("discount_type")
  discountValue          Int?          @map("discount_value")
  subscriptionPricePaise BigInt?       @map("subscription_price_paise")
  status                 ProductStatus @default(DRAFT)
  isSubscribable         Boolean       @default(false) @map("is_subscribable")
  isFeatured             Boolean       @default(false) @map("is_featured")
  displayOrder           Int           @default(0) @map("display_order")
  availableFrom          DateTime?     @map("available_from") @db.Date
  availableUntil         DateTime?     @map("available_until") @db.Date
  seoTitle               String?       @map("seo_title")
  seoDescription         String?       @map("seo_description")
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?       @map("created_by") @db.Uuid
  updatedBy              String?       @map("updated_by") @db.Uuid

  business          Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items             ComboItem[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  subscriptionItems SubscriptionItem[]
  planItems         SubscriptionPlanItem[]
  favorites         Favorite[]
  zoneAvailability  ProductZoneAvailability[]

  @@index([businessId, status])
  @@map("combos")
}

model ComboItem {
  id           String @id @db.Uuid
  comboId      String @map("combo_id") @db.Uuid
  variantId    String @map("variant_id") @db.Uuid
  quantity     Int
  displayOrder Int    @default(0) @map("display_order")

  combo   Combo          @relation(fields: [comboId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([comboId, variantId])
  @@map("combo_items")
}

/// Per-zone availability without duplicating the catalogue (ADR-005).
/// Absence of a row means "available everywhere" — MVP writes no rows.
model ProductZoneAvailability {
  id                 String  @id @db.Uuid
  variantId          String? @map("variant_id") @db.Uuid
  comboId            String? @map("combo_id") @db.Uuid
  deliveryZoneId     String  @map("delivery_zone_id") @db.Uuid
  isAvailable        Boolean @default(true) @map("is_available")
  priceOverridePaise BigInt? @map("price_override_paise")

  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  combo        Combo?          @relation(fields: [comboId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone    @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)

  @@unique([variantId, deliveryZoneId])
  @@unique([comboId, deliveryZoneId])
  @@map("product_zone_availability")
}

// ══════════════════════════════════════════════════════════════════════════
// Serviceability and fulfilment — docs/04 §6
// ══════════════════════════════════════════════════════════════════════════

/// A city the business operates in, or intends to.
/// NEVER deleted — expansion and retreat are both status changes, because
/// historical addresses and orders must keep resolving to a real row (BR-SV6).
model City {
  id           String               @id @db.Uuid
  businessId   String               @map("business_id") @db.Uuid
  name         String
  slug         String               @db.Citext
  displayName  String?              @map("display_name")
  state        String
  country      String               @default("IN")
  timezone     String               @default("Asia/Kolkata")
  status       ServiceabilityStatus @default(INACTIVE)
  displayOrder Int                  @default(0) @map("display_order")
  activatedAt  DateTime?            @map("activated_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?              @map("created_by") @db.Uuid
  updatedBy    String?              @map("updated_by") @db.Uuid

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  pincodes  ServicePincode[]
  addresses Address[]
  zones     DeliveryZone[]

  @@unique([businessId, slug])
  // Supports the composite FK that keeps a pincode inside its own business.
  @@unique([id, businessId], name: "city_id_business_id")
  @@index([businessId, status])
  @@index([businessId, state])
  @@map("cities")
}

/// A pincode the business may deliver to, owned by exactly one city.
/// UNIQUE (business_id, pincode) keeps serviceability deterministic: a
/// pincode resolves to one city, so "is this serviceable" has one answer.
model ServicePincode {
  id             String               @id @db.Uuid
  businessId     String               @map("business_id") @db.Uuid
  cityId         String               @map("city_id") @db.Uuid
  pincode        String
  areaName       String?              @map("area_name")
  status         ServiceabilityStatus @default(INACTIVE)
  displayOrder   Int                  @default(0) @map("display_order")
  activatedAt    DateTime?            @map("activated_at") @db.Timestamptz(6)
  /// PHASE 06. A zone may NARROW serviceability, never widen it (ADR-024, BR-SV8).
  deliveryZoneId String?              @map("delivery_zone_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?              @map("created_by") @db.Uuid
  updatedBy      String?              @map("updated_by") @db.Uuid

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  city         City          @relation(fields: [cityId], references: [id], onDelete: Restrict)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  @@unique([businessId, pincode])
  @@index([cityId, status])
  @@index([businessId, status])
  @@map("service_pincodes")
}

/// Operational delivery area. Belongs to a known city (ADR-029) — unlike an
/// address, there is no "unserviceable zone" case.
model DeliveryZone {
  id                     String    @id @db.Uuid
  businessId             String    @map("business_id") @db.Uuid
  cityId                 String    @map("city_id") @db.Uuid
  name                   String
  code                   String    @db.Citext
  deliveryFeePaise       BigInt    @default(0) @map("delivery_fee_paise")
  freeDeliveryAbovePaise BigInt?   @map("free_delivery_above_paise")
  minOrderValuePaise     BigInt    @default(0) @map("min_order_value_paise")
  maxDailyOrders         Int?      @map("max_daily_orders")
  isActive               Boolean   @default(true) @map("is_active")
  displayOrder           Int       @default(0) @map("display_order")
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business         Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  city             City                      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  pincodes         ServicePincode[]
  addresses        Address[]
  slotAssignments  SlotZoneAssignment[]
  slotCapacity     SlotCapacity[]
  orders           Order[]
  subscriptions    Subscription[]
  holidays         BusinessHoliday[]
  zoneAvailability ProductZoneAvailability[]

  @@unique([businessId, code])
  @@index([cityId, isActive])
  @@map("delivery_zones")
}

/// Admin-configured delivery windows. NO slot time is hard-coded anywhere
/// in the codebase — there is no MORNING/EVENING enum (BR-SV7).
model DeliverySlot {
  id                 String    @id @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  name               String
  code               String    @db.Citext
  startTime          DateTime  @map("start_time") @db.Time(6)
  endTime            DateTime  @map("end_time") @db.Time(6)
  cutoffTime         DateTime  @map("cutoff_time") @db.Time(6)
  cutoffDaysBefore   Int       @default(0) @map("cutoff_days_before")
  availableDays      Int[]     @map("available_days") @db.SmallInt
  defaultCapacity    Int       @map("default_capacity")
  deliveryFeePaise   BigInt?   @map("delivery_fee_paise")
  minOrderValuePaise BigInt?   @map("min_order_value_paise")
  isActive           Boolean   @default(true) @map("is_active")
  displayOrder       Int       @default(0) @map("display_order")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  business        Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  zoneAssignments SlotZoneAssignment[]
  capacity        SlotCapacity[]
  orders          Order[]
  subscriptions   Subscription[]
  subDeliveries   SubscriptionDelivery[]
  holidays        BusinessHoliday[]
  preferredBy     CustomerProfile[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@map("delivery_slots")
}

/// No rows for a slot means it serves ALL zones (MVP convenience).
model SlotZoneAssignment {
  id               String  @id @db.Uuid
  deliverySlotId   String  @map("delivery_slot_id") @db.Uuid
  deliveryZoneId   String  @map("delivery_zone_id") @db.Uuid
  capacityOverride Int?    @map("capacity_override")
  isActive         Boolean @default(true) @map("is_active")

  slot DeliverySlot @relation(fields: [deliverySlotId], references: [id], onDelete: Cascade)
  zone DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)

  @@unique([deliverySlotId, deliveryZoneId])
  @@map("slot_zone_assignments")
}

/// The concurrency control point of the entire system (PHASE 06 booking).
/// CHECK (booked_count <= capacity) means over-booking is a failed
/// transaction, not an undeliverable order (BR-D6).
model SlotCapacity {
  id                       String   @id @db.Uuid
  deliverySlotId           String   @map("delivery_slot_id") @db.Uuid
  deliveryZoneId           String   @map("delivery_zone_id") @db.Uuid
  serviceDate              DateTime @map("service_date") @db.Date
  capacity                 Int
  reservedForSubscriptions Int      @default(0) @map("reserved_for_subscriptions")
  bookedCount              Int      @default(0) @map("booked_count")
  isBlocked                Boolean  @default(false) @map("is_blocked")
  blockReason              String?  @map("block_reason")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slot DeliverySlot @relation(fields: [deliverySlotId], references: [id], onDelete: Cascade)
  zone DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)

  @@unique([deliverySlotId, deliveryZoneId, serviceDate])
  @@index([serviceDate, deliveryZoneId])
  @@map("slot_capacity")
}

model BusinessHoliday {
  id             String   @id @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  holidayDate    DateTime @map("holiday_date") @db.Date
  name           String
  deliveryZoneId String?  @map("delivery_zone_id") @db.Uuid
  deliverySlotId String?  @map("delivery_slot_id") @db.Uuid
  isFullClosure  Boolean  @default(true) @map("is_full_closure")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  zone     DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  slot     DeliverySlot? @relation(fields: [deliverySlotId], references: [id], onDelete: Cascade)

  @@index([businessId, holidayDate])
  @@map("business_holidays")
}

// ══════════════════════════════════════════════════════════════════════════
// Ordering — docs/04 §7
// ══════════════════════════════════════════════════════════════════════════

/// A cart is NOT an order state (BR-O1 / doc 09 §1). Totals are never stored
/// here — they are recomputed from live catalogue prices on read (BR-K2).
model Cart {
  id                String    @id @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  customerProfileId String    @map("customer_profile_id") @db.Uuid
  deliveryAddressId String?   @map("delivery_address_id") @db.Uuid
  deliverySlotId    String?   @map("delivery_slot_id") @db.Uuid
  serviceDate       DateTime? @map("service_date") @db.Date
  couponCode        String?   @map("coupon_code")
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  deliveryAddress Address?        @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           CartItem[]

  @@unique([customerProfileId])
  @@index([lastActivityAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  comboId   String?  @map("combo_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  combo   Combo?          @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@unique([cartId, comboId])
  @@map("cart_items")
}

/// The central transactional record. Never deleted, never soft-deleted.
/// Snapshots everything mutable so a later price or address edit can never
/// rewrite history (ADR-021).
model Order {
  id                     String        @id @db.Uuid
  businessId             String        @map("business_id") @db.Uuid
  orderNumber            String        @unique @map("order_number")
  customerProfileId      String        @map("customer_profile_id") @db.Uuid
  status                 OrderStatus   @default(PENDING)
  source                 OrderSource   @default(ONE_TIME)
  channel                OrderChannel  @default(WEB)
  subscriptionId         String?       @map("subscription_id") @db.Uuid
  subscriptionDeliveryId String?       @map("subscription_delivery_id") @db.Uuid
  deliveryZoneId         String        @map("delivery_zone_id") @db.Uuid
  deliverySlotId         String        @map("delivery_slot_id") @db.Uuid
  serviceDate            DateTime      @map("service_date") @db.Date
  slotStartTime          DateTime      @map("slot_start_time") @db.Time(6)
  slotEndTime            DateTime      @map("slot_end_time") @db.Time(6)
  slotNameSnapshot       String        @map("slot_name_snapshot")
  addressId              String?       @map("address_id") @db.Uuid
  addressSnapshot        Json          @map("address_snapshot")
  customerNameSnapshot   String        @map("customer_name_snapshot")
  customerPhoneSnapshot  String        @map("customer_phone_snapshot")
  subtotalPaise          BigInt        @map("subtotal_paise")
  discountPaise          BigInt        @default(0) @map("discount_paise")
  deliveryFeePaise       BigInt        @default(0) @map("delivery_fee_paise")
  taxPaise               BigInt        @default(0) @map("tax_paise")
  totalPaise             BigInt        @map("total_paise")
  couponCode             String?       @map("coupon_code")
  paymentMethod          PaymentMethod @default(COD) @map("payment_method")
  paymentStatus          PaymentStatus @default(DUE) @map("payment_status")
  customerNote           String?       @map("customer_note")
  internalNote           String?       @map("internal_note")
  cancelledAt            DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledByType        CancelActor?  @map("cancelled_by_type")
  cancelledByUserId      String?       @map("cancelled_by_user_id") @db.Uuid
  cancellationReason     String?       @map("cancellation_reason")
  confirmedAt            DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  preparedAt             DateTime?     @map("prepared_at") @db.Timestamptz(6)
  dispatchedAt           DateTime?     @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt            DateTime?     @map("delivered_at") @db.Timestamptz(6)
  placedAt               DateTime      @default(now()) @map("placed_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerProfile CustomerProfile       @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  deliveryZone    DeliveryZone          @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  deliverySlot    DeliverySlot          @relation(fields: [deliverySlotId], references: [id], onDelete: Restrict)
  address         Address?              @relation(fields: [addressId], references: [id], onDelete: Restrict)
  subscription    Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subDelivery     SubscriptionDelivery? @relation("OrderFromDelivery", fields: [subscriptionDeliveryId], references: [id], onDelete: SetNull)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payment       Payment?
  refunds       Refund[]
  reviews       Review[]
  redemptions   CouponRedemption[]
  fulfilledFor  SubscriptionDelivery[] @relation("DeliveryFulfilledByOrder")

  @@index([customerProfileId, placedAt(sort: Desc)])
  @@index([status, serviceDate])
  @@index([serviceDate, deliverySlotId, status])
  @@index([subscriptionId])
  @@index([businessId, placedAt(sort: Desc)])
  @@map("orders")
}

/// A combo produces one PRICED parent row plus N zero-priced component rows.
/// Money reads rows where is_component = false; inventory and prep read rows
/// where is_component = true. Neither view double-counts (doc 12 §2).
model OrderItem {
  id                  String   @id @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  comboId             String?  @map("combo_id") @db.Uuid
  parentItemId        String?  @map("parent_item_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  variantNameSnapshot String?  @map("variant_name_snapshot")
  skuSnapshot         String?  @map("sku_snapshot")
  imageUrlSnapshot    String?  @map("image_url_snapshot")
  unit                String?
  unitValue           Decimal? @map("unit_value") @db.Decimal(10, 3)
  quantity            Int
  unitPricePaise      BigInt   @map("unit_price_paise")
  mrpPaise            BigInt?  @map("mrp_paise")
  discountPaise       BigInt   @default(0) @map("discount_paise")
  taxRateBps          Int      @default(0) @map("tax_rate_bps")
  taxPaise            BigInt   @default(0) @map("tax_paise")
  lineTotalPaise      BigInt   @map("line_total_paise")
  isComponent         Boolean  @default(false) @map("is_component")
  fulfilmentStatus    String?  @map("fulfilment_status")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  combo      Combo?          @relation(fields: [comboId], references: [id], onDelete: Restrict)
  parentItem OrderItem?      @relation("ComboExplosion", fields: [parentItemId], references: [id], onDelete: Cascade)
  components OrderItem[]     @relation("ComboExplosion")

  @@index([orderId])
  @@map("order_items")
}

/// Append-only. Every transition, who caused it, and why.
model OrderStatusHistory {
  id          String       @id @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorType   String       @map("actor_type")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  reason      String?
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Makes retries safe on every unsafe endpoint (BR-K7).
/// Replaying a key with a DIFFERENT body returns 422 — a silent wrong answer
/// would be worse than an error.
model IdempotencyKey {
  id             String            @id @db.Uuid
  key            String
  userId         String            @map("user_id") @db.Uuid
  endpoint       String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  resourceId     String?           @map("resource_id") @db.Uuid
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ══════════════════════════════════════════════════════════════════════════
// Subscription — docs/04 §8, docs/11
// ══════════════════════════════════════════════════════════════════════════

/// The OFFER, authored by an admin. A customer never edits a plan; they edit
/// their subscription.
model SubscriptionPlan {
  id                    String        @id @db.Uuid
  businessId            String        @map("business_id") @db.Uuid
  name                  String
  slug                  String        @db.Citext
  description           String?
  imageUrl              String?       @map("image_url")
  frequencyType         FrequencyType @map("frequency_type")
  allowedDays           Int[]         @map("allowed_days") @db.SmallInt
  defaultDays           Int[]         @map("default_days") @db.SmallInt
  discountType          DiscountType? @map("discount_type")
  discountValue         Int?          @map("discount_value")
  minDurationDays       Int?          @map("min_duration_days")
  maxDurationDays       Int?          @map("max_duration_days")
  maxPauseDaysPerMonth  Int?          @map("max_pause_days_per_month")
  maxSkipsPerMonth      Int?          @map("max_skips_per_month")
  pauseNoticeHours      Int           @default(0) @map("pause_notice_hours")
  cancellationNoticeHours Int         @default(0) @map("cancellation_notice_hours")
  allowSlotChange       Boolean       @default(true) @map("allow_slot_change")
  allowQuantityChange   Boolean       @default(true) @map("allow_quantity_change")
  allowedSlotIds        String[]      @map("allowed_slot_ids") @db.Uuid
  status                ProductStatus @default(DRAFT)
  isFeatured            Boolean       @default(false) @map("is_featured")
  displayOrder          Int           @default(0) @map("display_order")
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             String?       @map("created_by") @db.Uuid
  updatedBy             String?       @map("updated_by") @db.Uuid

  business      Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items         SubscriptionPlanItem[]
  subscriptions Subscription[]

  @@index([businessId, status])
  @@map("subscription_plans")
}

model SubscriptionPlanItem {
  id                 String  @id @db.Uuid
  planId             String  @map("plan_id") @db.Uuid
  variantId          String? @map("variant_id") @db.Uuid
  comboId            String? @map("combo_id") @db.Uuid
  quantity           Int     @default(1)
  isQuantityEditable Boolean @default(true) @map("is_quantity_editable")

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  variant ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  combo   Combo?           @relation(fields: [comboId], references: [id], onDelete: Restrict)

  @@unique([planId, variantId])
  @@unique([planId, comboId])
  @@map("subscription_plan_items")
}

/// The customer's CONTRACT. Deliberately NOT a boolean on orders — a
/// subscription has its own lifecycle and generates dated occurrences.
model Subscription {
  id                    String             @id @db.Uuid
  businessId            String             @map("business_id") @db.Uuid
  subscriptionNumber    String             @unique @map("subscription_number")
  customerProfileId     String             @map("customer_profile_id") @db.Uuid
  subscriptionPlanId    String?            @map("subscription_plan_id") @db.Uuid
  status                SubscriptionStatus @default(ACTIVE)
  frequencyType         FrequencyType      @map("frequency_type")
  deliveryDays          Int[]              @map("delivery_days") @db.SmallInt
  intervalDays          Int?               @map("interval_days")
  deliverySlotId        String             @map("delivery_slot_id") @db.Uuid
  addressId             String             @map("address_id") @db.Uuid
  deliveryZoneId        String             @map("delivery_zone_id") @db.Uuid
  startDate             DateTime           @map("start_date") @db.Date
  endDate               DateTime?          @map("end_date") @db.Date
  nextDeliveryDate      DateTime?          @map("next_delivery_date") @db.Date
  lastDeliveryDate      DateTime?          @map("last_delivery_date") @db.Date
  pausedAt              DateTime?          @map("paused_at") @db.Timestamptz(6)
  pauseUntilDate        DateTime?          @map("pause_until_date") @db.Date
  pauseReason           String?            @map("pause_reason")
  resumedAt             DateTime?          @map("resumed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelledByType       CancelActor?       @map("cancelled_by_type")
  cancellationReason    String?            @map("cancellation_reason")
  /// LOCKED at subscription time. A catalogue price change must never
  /// silently re-price an existing subscription (BR-S7).
  pricePerDeliveryPaise BigInt             @map("price_per_delivery_paise")
  deliveryFeePaise      BigInt             @default(0) @map("delivery_fee_paise")
  paymentMethod         PaymentMethod      @default(COD) @map("payment_method")
  totalDeliveriesCount  Int                @default(0) @map("total_deliveries_count")
  totalSkippedCount     Int                @default(0) @map("total_skipped_count")
  /// Scheduler watermark. Generation is "extend from here to horizon", which
  /// is what makes the generator idempotent (BR-S17).
  generatedUntilDate    DateTime?          @map("generated_until_date") @db.Date
  customerNote          String?            @map("customer_note")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerProfile CustomerProfile   @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  plan            SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  deliverySlot    DeliverySlot      @relation(fields: [deliverySlotId], references: [id], onDelete: Restrict)
  address         Address           @relation(fields: [addressId], references: [id], onDelete: Restrict)
  deliveryZone    DeliveryZone      @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)

  items      SubscriptionItem[]
  deliveries SubscriptionDelivery[]
  events     SubscriptionEvent[]
  orders     Order[]

  @@index([customerProfileId, status])
  @@index([status, nextDeliveryDate])
  @@index([deliverySlotId, status])
  @@index([businessId, status])
  @@map("subscriptions")
}

model SubscriptionItem {
  id                  String   @id @db.Uuid
  subscriptionId      String   @map("subscription_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  comboId             String?  @map("combo_id") @db.Uuid
  quantity            Int
  unitPricePaise      BigInt   @map("unit_price_paise")
  productNameSnapshot String   @map("product_name_snapshot")
  variantNameSnapshot String?  @map("variant_name_snapshot")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  combo        Combo?          @relation(fields: [comboId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, variantId])
  @@unique([subscriptionId, comboId])
  @@map("subscription_items")
}

/// THE HEART OF THE ENGINE. One row per scheduled occurrence.
///
/// UNIQUE (subscription_id, delivery_date) makes duplicate deliveries
/// structurally impossible, and the partial UNIQUE on orders
/// (subscription_delivery_id) makes duplicate orders impossible. Together
/// they hold under concurrent workers, retries and redeploys with no
/// distributed lock (BR-S9).
model SubscriptionDelivery {
  id                 String            @id @db.Uuid
  subscriptionId     String            @map("subscription_id") @db.Uuid
  deliveryDate       DateTime          @map("delivery_date") @db.Date
  deliverySlotId     String            @map("delivery_slot_id") @db.Uuid
  addressId          String            @map("address_id") @db.Uuid
  status             SubDeliveryStatus @default(SCHEDULED)
  orderId            String?           @unique @map("order_id") @db.Uuid
  expectedTotalPaise BigInt            @map("expected_total_paise")
  skippedAt          DateTime?         @map("skipped_at") @db.Timestamptz(6)
  skippedByType      CancelActor?      @map("skipped_by_type")
  skipReason         String?           @map("skip_reason")
  failureReason      String?           @map("failure_reason")
  materialisedAt     DateTime?         @map("materialised_at") @db.Timestamptz(6)
  reminderSentAt     DateTime?         @map("reminder_sent_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  slot         DeliverySlot @relation(fields: [deliverySlotId], references: [id], onDelete: Restrict)
  address      Address      @relation(fields: [addressId], references: [id], onDelete: Restrict)
  order        Order?       @relation("DeliveryFulfilledByOrder", fields: [orderId], references: [id], onDelete: SetNull)

  createdOrders Order[] @relation("OrderFromDelivery")

  @@unique([subscriptionId, deliveryDate])
  @@index([deliveryDate, status])
  @@index([subscriptionId, deliveryDate(sort: Desc)])
  @@map("subscription_deliveries")
}

/// Append-only lifecycle log, mirroring order_status_history.
model SubscriptionEvent {
  id             String   @id @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  eventType      String   @map("event_type")
  actorType      String   @map("actor_type")
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt(sort: Desc)])
  @@map("subscription_events")
}

// ══════════════════════════════════════════════════════════════════════════
// Inventory — docs/04 §9
// ══════════════════════════════════════════════════════════════════════════

/// quantity_available is COMPUTED (on_hand - reserved), never stored.
/// Storing it would create a third number that can disagree with the other
/// two, and the bug would surface as overselling (BR-I6).
model Inventory {
  id                String    @id @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  variantId         String    @map("variant_id") @db.Uuid
  locationCode      String    @default("MAIN") @map("location_code")
  quantityOnHand    Int       @default(0) @map("quantity_on_hand")
  quantityReserved  Int       @default(0) @map("quantity_reserved")
  lowStockThreshold Int       @default(0) @map("low_stock_threshold")
  /// false = made to order; never blocks a sale (BR-I9).
  trackInventory    Boolean   @default(true) @map("track_inventory")
  allowBackorder    Boolean   @default(false) @map("allow_backorder")
  lastCountedAt     DateTime? @map("last_counted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([variantId, locationCode])
  @@index([businessId])
  @@map("inventory")
}

/// Append-only ledger. Every change to `inventory` writes a movement in the
/// SAME transaction; the sum of movements must equal quantity_on_hand.
model InventoryMovement {
  id            String          @id @db.Uuid
  inventoryId   String          @map("inventory_id") @db.Uuid
  variantId     String          @map("variant_id") @db.Uuid
  reason        InventoryReason
  quantityDelta Int             @map("quantity_delta")
  /// On-hand after this movement — makes the ledger auditable without
  /// replaying it from the beginning.
  quantityAfter Int             @map("quantity_after")
  reservedDelta Int             @default(0) @map("reserved_delta")
  referenceType String?         @map("reference_type")
  referenceId   String?         @map("reference_id") @db.Uuid
  note          String?
  actorUserId   String?         @map("actor_user_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ══════════════════════════════════════════════════════════════════════════
// Payment — docs/04 §10, docs/19
// ══════════════════════════════════════════════════════════════════════════

/// One row per order. Exists at MVP with COD rows so that adding Razorpay is
/// an adapter, not a migration (ADR-014).
/// Payment status is INDEPENDENT of order status (BR-P2).
model Payment {
  id                  String        @id @db.Uuid
  orderId             String        @unique @map("order_id") @db.Uuid
  method              PaymentMethod
  status              PaymentStatus @default(DUE)
  amountPaise         BigInt        @map("amount_paise")
  amountPaidPaise     BigInt        @default(0) @map("amount_paid_paise")
  amountRefundedPaise BigInt        @default(0) @map("amount_refunded_paise")
  currency            String        @default("INR")
  provider            String?
  providerPaymentId   String?       @map("provider_payment_id")
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz(6)
  collectedByUserId   String?       @map("collected_by_user_id") @db.Uuid
  failureReason       String?       @map("failure_reason")
  /// Never store raw card or UPI credentials (BR-P8).
  metadata            Json?
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]
  refunds  Refund[]

  @@index([status])
  @@map("payments")
}

model PaymentAttempt {
  id                String   @id @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  provider          String
  providerOrderId   String?  @map("provider_order_id")
  providerPaymentId String?  @map("provider_payment_id")
  status            String
  amountPaise       BigInt   @map("amount_paise")
  errorCode         String?  @map("error_code")
  errorMessage      String?  @map("error_message")
  /// Redacted through an allow-list before storage (doc 19 §7).
  rawResponse       Json?    @map("raw_response")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt(sort: Desc)])
  @@map("payment_attempts")
}

model Refund {
  id                 String       @id @db.Uuid
  paymentId          String       @map("payment_id") @db.Uuid
  orderId            String       @map("order_id") @db.Uuid
  amountPaise        BigInt       @map("amount_paise")
  reason             String
  status             RefundStatus @default(PENDING)
  providerRefundId   String?      @map("provider_refund_id")
  initiatedByUserId  String?      @map("initiated_by_user_id") @db.Uuid
  processedAt        DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("refunds")
}

/// Stored BEFORE processing so a replay or out-of-order webhook is safe.
/// UNIQUE (provider, event_id) is the replay guard (BR-P7).
model PaymentWebhookEvent {
  id                String    @id @db.Uuid
  provider          String
  eventId           String    @map("event_id")
  eventType         String    @map("event_type")
  payload           Json
  signatureVerified Boolean   @default(false) @map("signature_verified")
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(6)
  processingError   String?   @map("processing_error")
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

// ══════════════════════════════════════════════════════════════════════════
// Engagement — docs/04 §11, docs/18
// ══════════════════════════════════════════════════════════════════════════

/// Transactional outbox. Written in the SAME transaction as the business
/// change, dispatched asynchronously. Guarantees "order placed => email
/// eventually sent" without letting email failure roll back an order.
model NotificationOutbox {
  id            String       @id @db.Uuid
  businessId    String?      @map("business_id") @db.Uuid
  eventType     String       @map("event_type")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  /// Self-contained: dispatch performs no database lookups (BR-N6).
  payload       Json
  dedupeKey     String?      @unique @map("dedupe_key")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?      @map("last_error")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  logs     NotificationLog[]

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@map("notification_outbox")
}

/// The customer-visible in-app feed. The only channel with no external
/// dependency, so it is the reliability floor.
model Notification {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  actionUrl String?   @map("action_url")
  imageUrl  String?   @map("image_url")
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationLog {
  id                String                  @id @db.Uuid
  outboxId          String?                 @map("outbox_id") @db.Uuid
  userId            String?                 @map("user_id") @db.Uuid
  channel           NotificationChannelType
  /// Redacted in logs and exports (BR-N8).
  recipient         String?
  templateKey       String?                 @map("template_key")
  provider          String?
  providerMessageId String?                 @map("provider_message_id")
  status            String
  error             String?
  sentAt            DateTime?               @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?               @map("delivered_at") @db.Timestamptz(6)
  openedAt          DateTime?               @map("opened_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  outbox NotificationOutbox? @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([outboxId])
  @@index([providerMessageId])
  @@map("notification_logs")
}

/// Transactional notifications cannot be opted out of; marketing requires
/// explicit opt-in (BR-N4).
model NotificationPreference {
  id        String                  @id @db.Uuid
  userId    String                  @map("user_id") @db.Uuid
  channel   NotificationChannelType
  category  String
  isEnabled Boolean                 @default(true) @map("is_enabled")
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@map("notification_preferences")
}

model Favorite {
  id                String   @id @db.Uuid
  customerProfileId String   @map("customer_profile_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  comboId           String?  @map("combo_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  combo           Combo?          @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, productId])
  @@unique([customerProfileId, comboId])
  @@map("favorites")
}

/// P2 feature; schema defined now. `orderId` is the verified-purchase proof.
model Review {
  id                String       @id @db.Uuid
  customerProfileId String       @map("customer_profile_id") @db.Uuid
  productId         String       @map("product_id") @db.Uuid
  orderId           String       @map("order_id") @db.Uuid
  rating            Int          @db.SmallInt
  title             String?
  body              String?
  status            ReviewStatus @default(PENDING)
  moderatedBy       String?      @map("moderated_by") @db.Uuid
  moderatedAt       DateTime?    @map("moderated_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([customerProfileId, productId, orderId])
  @@index([productId, status])
  @@map("reviews")
}

// ══════════════════════════════════════════════════════════════════════════
// Promotions — docs/04 §12 (P2 feature, schema defined now so that order
// code is written against it and enabling coupons is not a migration)
// ══════════════════════════════════════════════════════════════════════════

model Coupon {
  id                    String       @id @db.Uuid
  businessId            String       @map("business_id") @db.Uuid
  code                  String       @db.Citext
  description           String?
  discountType          DiscountType @map("discount_type")
  discountValue         Int          @map("discount_value")
  maxDiscountPaise      BigInt?      @map("max_discount_paise")
  minOrderValuePaise    BigInt       @default(0) @map("min_order_value_paise")
  appliesTo             String       @default("ALL") @map("applies_to")
  appliesToIds          String[]     @map("applies_to_ids") @db.Uuid
  firstOrderOnly        Boolean      @default(false) @map("first_order_only")
  usageLimitTotal       Int?         @map("usage_limit_total")
  usageLimitPerCustomer Int?         @map("usage_limit_per_customer")
  usedCount             Int          @default(0) @map("used_count")
  validFrom             DateTime?    @map("valid_from") @db.Timestamptz(6)
  validUntil            DateTime?    @map("valid_until") @db.Timestamptz(6)
  isActive              Boolean      @default(true) @map("is_active")
  createdBy             String?      @map("created_by") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  redemptions CouponRedemption[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@map("coupons")
}

model CouponRedemption {
  id                   String   @id @db.Uuid
  couponId             String   @map("coupon_id") @db.Uuid
  customerProfileId    String   @map("customer_profile_id") @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  discountAppliedPaise BigInt   @map("discount_applied_paise")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  coupon          Coupon          @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@index([customerProfileId])
  @@map("coupon_redemptions")
}
