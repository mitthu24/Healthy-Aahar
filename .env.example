# Healthy Aahar — server-side environment (apps/api, apps/worker)
#
# Copy to .env and fill in. NEVER commit .env (BR-ENV6).
# Every variable is validated at boot; a missing one fails the process with a
# readable message rather than at 2am on the first request (BR-ENV1).
#
# Frontend (NEXT_PUBLIC_*) variables live in each app's own .env.example.
# Full reference: docs/27-ENVIRONMENT-CONFIGURATION.md

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=local                          # local | preview | staging | production
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug                        # trace|debug|info|warn|error|fatal
APP_VERSION=dev                        # injected by CI from the git SHA

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://healthy_aahar:healthy_aahar_local@localhost:5432/healthy_aahar?schema=public
SHADOW_DATABASE_URL=postgresql://healthy_aahar:healthy_aahar_local@localhost:5434/healthy_aahar_shadow?schema=public
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ── CORS ───────────────────────────────────────────────────────────────────
# Explicit allow-list. Wildcards and *.vercel.app are REJECTED in production
# by the env schema (docs/23 §7).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Firebase: CUSTOMER project ─────────────────────────────────────────────
# Two separate projects. They MUST differ — the env schema refuses to start if
# they match, because that would remove the token-audience separation that
# makes privilege escalation impossible (ADR-010).
FIREBASE_CUSTOMER_PROJECT_ID=healthy-aahar-customer-local
FIREBASE_CUSTOMER_SERVICE_ACCOUNT_B64=

# ── Firebase: ADMIN project ────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=healthy-aahar-admin-local
FIREBASE_ADMIN_SERVICE_ACCOUNT_B64=
# Local only. The env schema rejects this in production.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ── Admin sessions ─────────────────────────────────────────────────────────
ADMIN_SESSION_MAX_AGE_SECONDS=43200    # 12h
ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800 # 30m

# ── Email (Brevo) ──────────────────────────────────────────────────────────
# NOTIFICATIONS_ENABLED must be false outside production. The env schema
# enforces it: non-production can never contact a real customer (BR-N9).
NOTIFICATIONS_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=orders@mail.healthyaahar.com
BREVO_SENDER_NAME=Healthy Aahar
BREVO_WEBHOOK_SECRET=

# ── Object storage (MinIO locally, Cloudflare R2 in deployed envs) ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=healthyaahar
R2_SECRET_ACCESS_KEY=healthyaahar_local
R2_BUCKET_NAME=healthy-aahar-media-local
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_BASE_URL=http://localhost:9000/healthy-aahar-media-local
R2_UPLOAD_MAX_BYTES=5242880
R2_PRESIGN_TTL_SECONDS=300

# ── Worker to API internal auth ────────────────────────────────────────────
# Different in every environment; compared in constant time (BR-ENV9).
INTERNAL_SERVICE_TOKEN=local-internal-token-change-me

# ── Business defaults ──────────────────────────────────────────────────────
# These SEED the settings table on first run. After that the database is
# authoritative and the admin panel owns them. No code branches on these
# values, and no city or pincode is ever configured here (BR-SV1).
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
BOOKING_HORIZON_DAYS=7
SUBSCRIPTION_GENERATION_HORIZON_DAYS=14
SUBSCRIPTION_MATERIALISE_HORIZON_HOURS=36

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MIN=300
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_ORDER_PER_MIN=10

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0

# ── Worker ─────────────────────────────────────────────────────────────────
WORKER_ENABLED=true
API_BASE_URL=http://localhost:4000
OUTBOX_DISPATCH_INTERVAL_MS=15000
OUTBOX_MAX_ATTEMPTS=5

# ── Feature flags (each switched on by its own phase) ──────────────────────
FEATURE_COUPONS=false
FEATURE_REVIEWS=false
FEATURE_ONLINE_PAYMENT=false
FEATURE_WHATSAPP=false
